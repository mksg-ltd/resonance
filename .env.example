NAVIDROME_BASE_URL=https://music.example.com
NAVIDROME_USER_ID=your-login-username
NAVIDROME_USER_PASSWORD=
NAVIDROME_SERVER_ID=home
NAVIDROME_ALLOW_HTTP=false
# Required for native HTTP operations; the local operator CLI does not need it.
RESONANCE__API_TOKEN=
RESONANCE__QDRANT__URL=http://localhost:6333
RESONANCE__EMBEDDING__PROFILE=vyakyarth
# For the Compose TEI service, keep this equal to the selected catalog model_id.
TEI_MODEL_ID=krutrim-ai-labs/Vyakyarth
# Use http://tei:80/v1 inside Compose or http://localhost:8085/v1 from the host.
RESONANCE__EMBEDDING__BASE_URL=http://tei:80/v1
# Leave empty for local TEI/Ollama. Hosted services may require a key.
RESONANCE__EMBEDDING__API_KEY=
